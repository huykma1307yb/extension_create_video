{
  "manifest_version": 3,
  "name": "Tạo video AI",
  "version": "1.1.0",
  "description": "Tạo kịch bản, prompt ảnh và prompt Veo 3 rồi dán thẳng vào Google Flow.",
  "permissions": [
    "sidePanel",
    "storage",
    "unlimitedStorage",
    "activeTab",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://labs.google/*",
    "https://flow.google.com/*"
  ],
  "action": {
    "default_title": "Mở Tạo video AI"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "background": {
    "service_worker": "bg.js"
  }
}